{
  "name": "vmmigrator",
  "version": "0.1.0",
  "description": "Discover and migrate Azure VMs off retiring series to v7/v6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "eslint src tests eslint.config.js vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.3"
  }
}
